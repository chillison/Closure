  "cards": [
    {
      "dot": "cyan",
      "title": "本地优先",
      "items": [
        "作品 = 普通文件（project.yaml / chapters/*.md），无需账号",
        "isomorphic-git 按 project 纯文本版本历史",
        "SQLite 只做注册库与派生检索索引，可重建"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent 纯编排层（ADR-2）",
      "items": [
        "LLM / 工具 / 文件 / db 全部经注入 seam，agent 无直接外部访问",
        "yaml 契约 + Zod 双表示，14 个 agent 各司其职",
        "写章链 / 审核链 / 拆链派发都是 runtime 节点"
      ]
    },
    {
      "dot": "rose",
      "title": "边界与隐私",
      "items": [
        "渲染层只能经 preload IPC 访问主进程，路径沙箱限项目目录",
        "云端 LLM 仅收推理请求，作品不落第三方存储",
        "API Key 本地加密保存"
      ]
    }
  ]
