  {
    "id": "cn.sentence.compound.single-negative-contrast",
    "namespace": "sentence.compound",
    "title": "删单层否定对比前半句",
    "level": "medium",
    "enabled": true,
    "review": "human",
    "note": "默认交人工：旧“不是…而是”regex 与 story-deslop handler 职责接近，且删前半句易改语义；排除“并不是…而是”，交给 contrastive-turn-preface。",
    "source": {
      "version": "rule-curation-v17",
      "canonicalKey": "sentence.compound\t\t(?<!不是不)([\\u4e00-\\u9fff]+)不是[\\u4e00-\\u9fff，、“”‘’]{1,20}[，,]而是",
      "importedFrom": "curated-cn-rule-samples"
    },
    "detector": {
      "type": "regex",
      "targets": [
        "(?<!不是不)([\\u4e00-\\u9fff]+)(?<!并)不是[\\u4e00-\\u9fff，、“”‘’]{1,20}[，,]而是"
      ]
    },
    "action": {
      "type": "replace",
      "replacements": [
        "$1是"
      ]
    }
  },
  {
    "id": "cn.sentence.compound.unrealized-preface",
    "namespace": "sentence.compound",
    "title": "删未发生部分前半句",
    "level": "medium",
    "enabled": false,
    "note": "默认关闭：与 cn.sentence.compound.contrastive-turn-preface 同 span 重叠率超过 90%，统一交给 canonical rule 判断。",
    "source": {
      "canonicalKey": "sentence.compound\t\t(?:并[未非不]|并?(?:没有|不[再是像])|非但)[\\u4e00-\\u9fff]{1,20}[,，](?:[更又全也倒只而][像是]|反[而倒]是?)",
      "importedFrom": "curated-cn-rule-samples"
    },
    "detector": {
      "type": "regex",
      "targets": [
        "(?:并[未非不]|并?(?:没有|不[再是像])|非但)[\\u4e00-\\u9fff]{1,20}[,，](?:[更又全也倒只而][像是]|反[而倒]是?)"
      ]
    },
    "action": {
      "type": "replace",
      "replacements": [
        ""
      ]
    }
  },
  {
    "id": "cn.sentence.compound.unrealized-subject-preface",
    "namespace": "sentence.compound",
    "title": "删未发生部分前半句",
    "level": "medium",
    "enabled": false,
    "review": "human",
    "note": "默认关闭：带主语的“并没有…而是”已由 cn.sentence.compound.contrastive-turn-preface 覆盖；旧替换还会删除有信息的真实对比。",
    "source": {
      "version": "rule-curation-v31",
      "canonicalKey": "sentence.compound\t\t([\\u4e00-\\u9fff]+)并(?:没有|未)[\\u4e00-\\u9fff，、“”‘’]{1,20}[，,]而是",
      "importedFrom": "curated-cn-rule-samples"
    },
    "detector": {
      "type": "regex",
      "targets": [
        "([\\u4e00-\\u9fff]+)并(?:没有|未)[\\u4e00-\\u9fff，、“”‘’]{1,20}[，,]而是"
      ]
    },
    "action": {
      "type": "replace",
      "replacements": [
        "$1"
      ]
    }
  },
