  {
    "id": "opening-cliche-era",
    "namespace": "opening.cliche",
    "title": "宏大时代开场",
    "level": "medium",
    "review": "human",
    "note": "默认交人工：“在这个…时代 / 随着…发展”可能是世界观设定或报告开场；旧报告 support 不足，当前 dataset 无命中，只在它替代具体场景时修。",
    "scope": {
      "layer": "narrative",
      "position": {
        "kind": "opening",
        "chars": 600
      }
    },
    "detector": {
      "type": "regex",
      "targets": [
        "在当今这个[^，。！？\\n]{0,12}的时代|在这个[^，。！？\\n]{0,12}的时代|随着[^，。！？\\n]{0,20}的不断发展"
      ]
    },
    "action": {
      "type": "suggest",
      "message": "删掉宏大背景，直接给具体时间、对象、事件或数据。"
    }
  },
