[
  {
    "id": "transition-summary-conclude",
    "namespace": "transition.summary",
    "title": "总结式过渡",
    "level": "medium",
    "enabled": false,
    "review": "human",
    "note": "默认关闭：「综上所述 / 总而言之 / 由此可见」在说明文和论证收束中可能合法，当前 dataset 真人侧不低于 AI 侧；保留资产给项目显式开启。",
    "detector": {
