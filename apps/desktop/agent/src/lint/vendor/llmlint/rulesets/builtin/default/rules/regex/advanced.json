    },
    "detector": {
      "type": "regex",
      "targets": [
        "(像|如同|仿佛|宛如)([^，。！？\\n]{1,30}?)一样(?=[，。！？、；：”'\"\\n]|$)"
      ],
      "flags": "g"
    },
    "action": {
      "type": "replace",
      "replacements": [
        "$1$2"
      ]
    }
