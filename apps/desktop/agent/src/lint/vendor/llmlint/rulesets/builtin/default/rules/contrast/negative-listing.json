[
  {
    "id": "negative-listing",
    "namespace": "contrast.negative-listing",
    "title": "负向列举",
    "level": "medium",
    "enabled": false,
    "note": "默认关闭：旧宽泛规则在当前 eval 中为 noise，且已由 story-deslop.negation-parade.* 两条叙述层校准规则接管；保留给项目显式开启。",
    "detector": {
      "type": "regex",
      "targets": [
        "(?:不是|并非)[^。！？\\n]{0,24}(?:。|，|,|；|;)?\\s*(?:也不是|不是|并非)"
