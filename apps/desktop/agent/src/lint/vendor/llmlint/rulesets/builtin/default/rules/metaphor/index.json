  {
    "id": "cn.metaphor.simile-modifier-shell",
    "namespace": "metaphor",
    "title": "删除特定比喻类修饰语",
    "level": "medium",
    "enabled": true,
    "note": "保持 human，不提回 agent：当前语料真人侧 35% 的文档命中（富集仅 2.8x），命中包含「犹如拗口令一般」「如是玩物一般」「仿佛是西瓜爆炸一般」这类出版小说里的有效比喻。比喻是叙述手段，密度过高才是问题——整篇判断交 story-deslop.metaphor-density 指纹，不要逐处当删除指令。",
    "source": {
      "version": "rule-curation-v32",
      "canonicalKey": "metaphor\t\t(?<=[\\u4e00-\\u9fff,，])(?:如|仿佛|[好就]?像|[宛犹][如若])[\\u4e00-\\u9fff]{1,10}(?:似的|一样|一?般)[的地,，]?(?=[\\u4e00-\\u9fff])",
      "importedFrom": "curated-cn-rule-samples"
    },
    "detector": {
      "type": "regex",
      "targets": [
        "(?<=[\\u4e00-\\u9fff,，])(?:如|仿佛|[好就]?像|[宛犹][如若])[\\u4e00-\\u9fff]{1,10}(?:似的|一样|一?般)[的地,，]?(?=[\\u4e00-\\u9fff])"
      ]
    },
    "action": {
      "type": "replace",
      "replacements": [
        ""
      ]
    }
  },
